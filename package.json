{
  "name": "infra-devtools",
  "version": "1.3.7",
  "description": "Infraestrutura padrão para desenvolvimento com Docker, Prometheus, Grafana e outras ferramentas essenciais.",
  "keywords": [
    "docker",
    "infraestrutura",
    "prometheus",
    "grafana",
    "monitoramento",
    "desenvolvimento",
    "devtools",
    "devops",
    "docker-compose"
  ],
  "homepage": "https://github.com/KleilsonSantos/infra-devtools#readme",
  "bugs": {
    "url": "https://github.com/KleilsonSantos/infra-devtools/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KleilsonSantos/infra-devtools.git"
  },
  "license": "MIT",
  "author": "Kleilson Santos",
  "type": "commonjs",
  "scripts": {
    "sonar:scanner": "sonar-scanner -Dsonar.projectKey=infra-devtools -Dsonar.sources=. -Dsonar.host.url=${SONAR_HOST_URL} -Dsonar.token=${SONAR_TOKEN_INFRA_DEVTOOLS} -Dsonar.sourceEncoding=UTF-8",
    "up": "docker compose --env-file .env up -d",
    "up-service": "docker compose --env-file .env up -d $SERVICE",
    "down": "docker compose --env-file .env down --volumes=false --remove-orphans",
    "down-service": "docker compose --env-file .env down --volumes=false --remove-orphans $SERVICE",
    "force-recreate": "docker compose --env-file .env down --volumes=false --remove-orphans && docker compose --env-file .env up -d",
    "logs": "docker compose --env-file .env logs -f $SERVICE",
    "ps": "docker compose --env-file .env ps",
    "ps-format": "docker compose --env-file .env ps --format 'table {{.Names}}'",
    "ps-detailed": "docker compose --env-file .env ps --format 'table {{.Names}}\\t{{.Status}}\\t{{.Ports}}'",
    "rebuild": "docker compose --env-file .env down --volumes=false --remove-orphans && docker compose --env-file .env build && docker compose --env-file .env up -d",
    "coverage": "pytest --cov=src --cov-report xml:reports/coverage/coverage.xml --cov-report html:reports/coverage --junitxml=reports/coverage/test-results.xml && python3 src/utils/convert_junit_to_sonar.py reports/coverage/test-results.xml reports/coverage/test-executions.xml",
    "test": "npm run coverage",
    "lint": "npx eslint --ext .ts,.js --fix",
    "format": "npx prettier --write \"{src,test,config,scripts,.github}/**/*.{ts,js,json,md,py}\" --ignore-path .prettierignore --ignore-unknown",
    "check-deps": "bash scripts/run-dependency-check.sh",
    "version:check": "bash scripts/version.sh check",
    "clean": "rm -rf reports/*",
    "sonar-scanner": "npx sonar-scanner -Dsonar.projectKey=infra-devtools -Dsonar.sources=. -Dsonar.host.url=$SONAR_HOST_URL -Dsonar.token=$SONAR_TOKEN_INFRA_DEVTOOLS -Dsonar.sourceEncoding=UTF-8",
    "preflight": "bash scripts/preflight.sh",
    "delivery-gate": "bash scripts/check-pr-delivery-gate.sh",
    "merge-pr": "bash scripts/merge-pr.sh",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "browserify-zlib": "^0.2.0",
    "config": "^5.0.1",
    "crypto-browserify": "^3.12.1",
    "dotenv": "^18.0.5",
    "dotenv-flow": "^4.1.0",
    "dotenv-safe": "^9.1.0",
    "express": "^5.2.1",
    "express-validator": "^7.3.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.4",
    "morgan": "^1.12.1",
    "progress": "^2.0.3",
    "simple-git": "^4.0.2",
    "stream-browserify": "^3.0.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@babel/preset-env": "^8.0.6",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/config": "^4.4.0",
    "@types/dotenv-safe": "^9.1.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mongoose": "^5.11.97",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.4",
    "@types/supertest": "^7.2.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.30.1",
    "assert": "^2.1.0",
    "axios": "^1.20.0",
    "babel-jest": "^30.5.2",
    "babel-loader": "^10.1.1",
    "babel-plugin-transform-es2015-modules-commonjs": "^6.26.2",
    "buffer": "^6.0.3",
    "clean-webpack-plugin": "^4.0.0",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "html-loader": "^5.1.0",
    "html-webpack-plugin": "^5.6.8",
    "https-browserify": "^1.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-html-reporter": "^4.4.2",
    "jest-junit": "^17.0.0",
    "jest-mock": "^30.5.2",
    "jest-silent-reporter": "^0.6.0",
    "jest-sonar": "^0.2.16",
    "jest-sonar-reporter": "^2.0.0",
    "jiti": "^2.7.0",
    "lint": "^1.2.2",
    "load-env": "^1.3.6",
    "loader-env": "^0.0.2",
    "mini-css-extract-plugin": "^2.10.2",
    "mongodb-memory-server": "^11.3.0",
    "os-browserify": "^0.3.0",
    "owasp-dependency-check": "^1.0.1",
    "path-browserify": "^1.0.1",
    "prettier": "^3.9.9",
    "process": "^0.11.10",
    "prom-client": "^15.1.3",
    "querystring-es3": "^0.2.1",
    "rimraf": "^6.1.3",
    "snyk": "^1.1307.4",
    "sonar-scanner": "^3.1.0",
    "sonarqube-scanner": "^5.0.1",
    "stream-http": "^3.2.0",
    "style-loader": "^4.0.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsc-progress": "^1.0.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "util": "^0.12.5",
    "webpack": "^5.111.1",
    "webpack-bundle-analyzer": "^5.4.0",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0",
    "whatwg-fetch": "^3.6.20"
  }
}
